# 服务端口
PORT=8080

# TOTP密钥（用于动态验证码，留空则自动生成）
# 可以使用 pyotp.random_base32() 生成，或使用页面上的二维码/密钥
TOTP_SECRET=

# Cloudflare API Token（需要 Firewall 权限）
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# Cloudflare Zone ID（域名区域 ID）
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id

# 子域名（必需，支持多个用逗号分隔，如 api.example.com,admin.example.com）
SUBDOMAIN=api.example.com,admin.example.com
