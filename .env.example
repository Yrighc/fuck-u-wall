# 服务端口
PORT=8080

# 监听地址（可选）：本机开发用 127.0.0.1（避免 macOS 本地网络权限导致启动慢）；Docker/公网部署用 0.0.0.0
HOST=127.0.0.1

# TOTP密钥（用于动态验证码，留空则自动生成）
# 可以使用 pyotp.random_base32() 生成，或使用页面上的二维码/密钥
TOTP_SECRET=

# Cloudflare API Token（需要 Firewall 权限）
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# Cloudflare Zone ID（域名区域 ID）
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id

# 子域名（必需，支持多个用逗号分隔，如 api.example.com,admin.example.com）
SUBDOMAIN=api.example.com,admin.example.com

# TOTP 爆破防护（可选）：单个客户端 IP 在窗口内允许的最大失败次数，达到后锁定
MAX_FAILED_ATTEMPTS=5
# 锁定时长（分钟）
LOCKOUT_MINUTES=15

# Turnstile 人机验证（必填，缺一不可）
# 站点 key（前端）：在 Cloudflare 控制台 Turnstile 页面创建 widget 后获取
TURNSTILE_SITEKEY=0x4AAAAAAEM5askdJyE9tkFz
# 后端密钥：仅服务端可见，用于 siteverify 校验（务必保密）
TURNSTILE_SECRET=
# 允许的前端域名白名单（逗号分隔，必须与 widget 注册域名一致；生产环境不要包含 localhost）
TURNSTILE_HOSTNAMES=localhost,127.0.0.1
